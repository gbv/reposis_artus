<?xml version="1.0" encoding="UTF-8"?>

<xed:template xmlns:xed="http://www.mycore.de/xeditor" xmlns:mir="http://www.mycore.de/mir">

  <!-- ======================================================= -->
  <!-- ========== Template Management Notes ========== -->
  <!--
      This XML document modifies and overrides templates from MIR.
      Templates are organized in dedicated sections below:
          1. Overrides
          2. Modifications
      Sections are provided for Admin, Host, Genre, and general templates including helper templates.
      Empty sections are avoided to reduce confusion.
      Templates within each section should be sorted alphabetically.
      General new templates should NOT be defined here; they must be placed in a artus-editor-includes file.
      Circular references must be avoided to prevent loops or unintended overrides.
  -->
  <!-- ======================================================= -->


  <!-- ======================================================= -->
                    <!-- 1. Overrides-->
  <!-- ======================================================= -->

  <!-- ========== overwrite mir templates and set them empty ========== -->

  <xed:template id="embargo">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="embargo.datetimepicker">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="host.articlenumber">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="institutes">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="institutes.repeat">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="sdnb">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="sdnb.repeat">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="shelfmark">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="shelfmark.book.relItemsearch">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="shelfmark.collection.relItemsearch">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="shelfmark.journal.relItemsearch">
    <!-- do nothing -->
  </xed:template>

  <xed:template id="shelfmark.lexicon.relItemsearch">
    <!-- do nothing -->
  </xed:template>





  <!-- ========== overwrite mir templates and change their content ========== -->

  <xed:template id="comment">
    <mir:textarea xpath="mods:note[@type='admin']" label="mir.comment.intern" help-text="{i18n:mir.help.comment}"
                  rows="2"/>
    <mir:textarea xpath="mods:note[@type='content']" label="mir.comment.content"
                  help-text="{i18n:mir.help.comment.content}" rows="2"/>
  </xed:template>


  <xed:template id="host.pages">
    <div class="mir-form-group row mir-modspart">
      <label class="col-md-3 col-form-label text-end form-label">
        <xed:output i18n="mir.pages"/>:
      </label>
      <div class="col-md-6">
        <xed:bind xpath="mods:part/mods:extent[@unit='pages']/mods:list">
          <input type="text" size="20" class="form-control form-control-inline"
                 placeholder="{i18n:mir.placeholder.host.pages}"/>
        </xed:bind>
      </div>
      <mir:help-pmud help-text="{i18n:mir.help.host.pages}"/>
    </div>
  </xed:template>

  <xed:template id="place">
    <xed:repeat xpath="mods:originInfo[@eventType='publication']/mods:place/mods:placeTerm[@type='text']" min="1"
                max="10">
      <div class="mir-form-group row">
        <label class="col-md-3 col-form-label text-end d-inline form-label">
          <xed:output i18n="mir.place"/>
        </label>
        <div class="col-md-6">
          <xed:bind xpath=".">
            <input class="form-control" type="text"/>
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:mir.help.place}" pmud="true"/>
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rights">
    <xed:bind xpath="mods:accessCondition[@type='use and reproduction']"
              initially="rights_reserved">
      <xed:if test="xed:call-java('org.mycore.common.xml.MCRXMLFunctions','isCurrentUserInRole','admin')">

        <div class="mir-form-group row required {$xed-validation-marker}">
          <label class="col-md-3 col-form-label text-end form-label">
            <xed:output i18n="mir.rights"/>
            :
          </label>
          <div class="col-md-6">
            <select class="form-control form-control-inline form-select">
              <option value="">
                <xed:output i18n="mir.select"/>
              </option>
              <xed:include
                uri="xslStyle:license-filter,items2options?genre={$genre_intern}:classification:editor:-1:children:mir_licenses"/>
            </select>
          </div>
          <mir:help-pmud help-text="{i18n:mir.help.rights}"/>
        </div>
      </xed:if>
    </xed:bind>
  </xed:template>


  <xed:template id="thesis.advisor.reviewer.all.repeated">
    <xed:bind
      xpath="mods:name[@type='personal'][mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']='aut']"/>
    <xed:bind
      xpath="mods:name[@type='personal'][mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']='mdc']"/>
    <mir:person.repeated help-text="{i18n:mir.help.thesis.advisor.reviewer}">
      <xed:include uri="xslStyle:items2options:classification:editor:-1:children:marcrelator"/>
    </mir:person.repeated>
  </xed:template>



  <xed:template id="title.original.nonrequired">
    <fieldset>
      <legend class="mir-fieldset-legend">
        <xed:output i18n="mir.title.type.original"/>
      </legend>
      <xed:bind xpath="mods:titleInfo">
        <div class="mir-fieldset-content">
          <!-- normales Titelfeld -->
          <mir:textfield
            xpath="mods:title"
            label="mir.title"
            placeholder="{i18n:artus.title.nonrequired}"
            help-text="{i18n:mir.help.title}"/>
          <mir:textfield
            xpath="mods:subTitle"
            label="mir.title.subTitle"
            help-text="{i18n:mir.help.title.subTitle}"/>
          <!-- verstecktes Feld als Fallback -->
          <input type="hidden"
                 id="autoReviewTitle"
                 data-xpath="mods:title"/>
        </div>
      </xed:bind>
    </fieldset>
  </xed:template>

  <!-- ======================================================= -->
                  <!--  2. Modifications-->
  <!-- ======================================================= -->
  <xed:modify ref="admin.fields">
    <xed:include ref="artus.sections" after="genre"/>
    <xed:include ref="subject.simple" after="subject.complex"/>
    <xed:remove ref="subject.complex"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:remove ref="related.item.other.search.of.all.items"/>
  </xed:modify>

  <xed:modify ref="genres.av.common">
    <xed:include ref="artus.sections" after="name.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.book">
    <xed:include ref="editor.repeated" after="author.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.book.common">
    <xed:include ref="artus.sections" after="year.issued"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
    <xed:remove ref="identifier.isbn"/>
    <xed:include ref="identifier.repeated" after="doi.handle.urn.repeated"/>
    <xed:include ref="link.repeated" after="identifier.repeated"/>
    <xed:remove ref="doi.handle.urn.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.dissertation">
    <xed:remove ref="date.submitted.datetimepicker"/>
    <xed:remove ref="date.accepted.datetimepicker"/>
  </xed:modify>

  <xed:modify ref="genres.entry">
    <xed:include ref="artus.sections" after="author.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.issue">
    <xed:include ref="artus.sections" after="author.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>


  <xed:modify ref="genres.journal.common">
    <xed:include ref="artus.sections" after="title.abbreviated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.preface">
    <xed:include ref="artus.sections" after="author.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.publication.common">
    <xed:include ref="artus.sections" after="author.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="identifier.repeated" after="doi.handle.urn.repeated"/>
    <xed:include ref="link.repeated" after="identifier.repeated"/>
    <xed:remove ref="doi.handle.urn.repeated"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.report.common">
    <xed:include ref="artus.sections" after="author.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.speech">
    <xed:include ref="artus.sections" after="author.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.teaching_material">
    <xed:include ref="artus.sections" after="name.repeated"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:include ref="author.metadataContact.repeated"/>
  </xed:modify>

  <xed:modify ref="genres.thesis.common">
    <xed:include ref="artus.sections" after="creator.place.college"/>
    <xed:include ref="artus.parts" after="artus.sections"/>
    <xed:remove ref="identifier.isbn"/>
    <xed:remove ref="type.of.resource.repeated"/>
    <xed:include ref="abstract.simple" after="abstract.repeated"/>
    <xed:remove ref="abstract.repeated"/>
    <xed:include ref="identifier.repeated" after="doi.handle.urn.repeated"/>
    <xed:remove ref="doi.handle.urn.repeated"/>
  </xed:modify>

  <xed:modify ref="titles.thesis.common">
    <xed:remove ref="title.translated"/>
  </xed:modify>

</xed:template>

